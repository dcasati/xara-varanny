#!/bin/sh
# xara-varanny: run xara under varanny without cutting off the disconnect.
#
# Usage: xara-varanny CONFIG
#
# varanny stops the modem with SIGTERM as soon as the client says "stop", which
# can be right after it asked for a disconnect. xara shuts down on the first
# SIGTERM without finishing an open link, so the other station never sees the
# link close and keeps retrying. This wrapper holds the SIGTERM until an open
# link reports DISCONNECTED (at most XARA_STOP_TIMEOUT seconds) and then
# forwards it to xara.
#
# Environment:
#   XARA               xara binary (default: /usr/local/bin/xara)
#   XARA_ARGS          extra xara arguments (default: --addr 0.0.0.0 --registered)
#   XARA_STOP_TIMEOUT  seconds to wait for DISCONNECTED (default: 20)

if [ $# -ne 1 ]; then
	echo "usage: xara-varanny CONFIG" >&2
	exit 64
fi
conf=$1
xara_bin=${XARA:-/usr/local/bin/xara}
xara_args=${XARA_ARGS---addr 0.0.0.0 --registered}
timeout=${XARA_STOP_TIMEOUT:-20}

run=$(mktemp -d "${TMPDIR:-/tmp}/xara-varanny.XXXXXX") || exit 1
mkfifo "$run/out" || { rm -rf "$run"; exit 1; }

# shellcheck disable=SC2086 # XARA_ARGS is meant to be split into words
"$xara_bin" --config "$conf" $xara_args > "$run/out" 2>&1 &
xara=$!

# Pass xara's output through and track whether a link is open.
while IFS= read -r l; do
	printf "%s\n" "$l"
	case $l in
	*"< CONNECTED "*) : > "$run/up" ;;
	*"< DISCONNECTED"*) rm -f "$run/up" ;;
	esac
done < "$run/out" &
reader=$!

stop() {
	n=0
	[ -e "$run/up" ] && echo "xara-varanny: waiting for the link to disconnect"
	while [ -e "$run/up" ] && [ $n -lt $((timeout * 2)) ]; do
		sleep 0.5
		n=$((n + 1))
	done
	kill -TERM $xara 2>/dev/null
}
trap stop TERM INT HUP

wait $xara
st=$?
# wait returns early when a trapped signal arrives; keep waiting for xara itself.
while kill -0 $xara 2>/dev/null; do
	wait $xara
	st=$?
done
wait $reader
rm -rf "$run"
exit $st
